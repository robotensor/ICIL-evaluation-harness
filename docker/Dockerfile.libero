# ICIL-evaluation-harness on top of vla-eval's LIBERO image.
# The base image's SHELL is `conda run -n libero /bin/bash -c`, so RUN commands already execute
# inside the `libero` conda env (Python 3.8). Build: ./docker/build.sh libero
ARG BASE=ghcr.io/allenai/vla-evaluation-harness/libero:0.5.0
FROM ${BASE}
ARG WHEEL
COPY ${WHEEL} /tmp/icil_eval.whl
# --no-deps: the image already pins numpy/pyyaml; container-side modules need nothing else.
RUN pip install --no-deps /tmp/icil_eval.whl \
    && python -c "import icil_eval.backends.vla_eval.benchmark, icil_eval.backends.vla_eval.libero; from icil_eval.registry.io import load_registry; print('icil_eval ok, tasks:', len(load_registry().tasks))"
